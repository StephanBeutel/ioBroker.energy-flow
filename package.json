{
  "name": "iobroker.energy-flow",
  "version": "0.1.0",
  "description": "ioBroker adapter for energy monitoring with responsive dashboard",
  "author": {
    "name": "Energy Flow Adapter",
    "email": "info@example.com"
  },
  "homepage": "https://github.com/StephanBeutel/EnergyFlow",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "energy",
    "solar",
    "battery",
    "grid",
    "dashboard",
    "monitoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StephanBeutel/EnergyFlow.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.2",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "nyc": "^18.0.0",
    "rimraf": "^6.1.3",
    "sinon": "^19.0.2",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.0"
  },
  "main": "main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "lib/",
    "main.js",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf main.js lib",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test:ts": "tsc -p tsconfig.build-test.json && mocha --timeout 10000 \"build-test/**/*.test.js\"",
    "test:build": "mocha --timeout 10000 \"build/**/*.test.js\"",
    "test:package": "mocha test/package --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit",
    "coverage": "nyc npm run test:ts",
    "lint": "eslint -c eslint.config.mjs .",
    "release": "release-script",
    "pack": "npm pack"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "bugs": {
    "url": "https://github.com/StephanBeutel/EnergyFlow/issues"
  },
  "readmeFilename": "README.md"
}
