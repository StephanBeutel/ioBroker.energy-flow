{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "noEmitOnError": true,
    "outDir": "./build/",
    "rootDir": "./src",
    "removeComments": false,
    "resolveJsonModule": true,
    "sourceMap": true,
    "inlineSourceMap": false,
    "types": ["@iobroker/types", "node", "mocha"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "build/**",
    "node_modules/**"
  ]
}
